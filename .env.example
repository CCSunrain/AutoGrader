# 数据库密码（db / backend / worker 共用）
POSTGRES_PASSWORD=autograder

# JWT 签名密钥
JWT_SECRET=dev-only-secret-key-do-not-use-in-production-0123456789abcdef

# LLM 配置
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=mimo-v2.5

# 日志级别（可选，默认 INFO）
LOG_LEVEL=INFO

# ===== 本地开发 =====
# 本地 PostgreSQL 连接串（Docker 映射端口 10080）
DATABASE_URL=postgresql+psycopg://autograder:autograder@localhost:10080/autograder
